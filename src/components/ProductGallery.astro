---
import type { ProductImage, ProductLocale } from '../data/products';

interface Props {
  id: string;
  images: readonly [ProductImage, ...ProductImage[]];
  productName: string;
  locale: ProductLocale;
  imageWidth: number;
  imageHeight: number;
}

const { id, images, productName, locale, imageWidth, imageHeight } = Astro.props as Props;
const hasMultipleImages = images.length > 1;
const labels = {
  en: {
    gallery: `${productName} image gallery`,
    select: (index: number) => `Show ${productName} image ${index + 1} of ${images.length}`,
  },
  ja: {
    gallery: `${productName} 画像ギャラリー`,
    select: (index: number) => `${productName} の画像 ${index + 1}/${images.length} を表示`,
  },
} as const;
const text = labels[locale];

const getImageDetails = (image: ProductImage, index: number) => {
  const path = `/images/${image.src}`;
  const extensionIndex = image.src.lastIndexOf('.');
  // const responsivePath = `/images/${image.src.slice(0, extensionIndex)}-p-500${image.src.slice(extensionIndex)}`;
  const fallbackAlt = index === 0 ? productName : `${productName} — ${index + 1}`;

  return {
    path,
    // responsivePath,
    alt: image.alt?.[locale] ?? fallbackAlt,
  };
};

const imageDetails = images.map(getImageDetails);
const primaryImage = imageDetails[0];
---

<div class="product-gallery" data-product-gallery>
  <img
    id={`${id}-image`}
    src={primaryImage.path}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    width={imageWidth}
    height={imageHeight}
    sizes="(max-width: 800px) 100vw, 800px"
    srcset={`${primaryImage.path} 500w, ${primaryImage.path} ${imageWidth}w`}
    alt={primaryImage.alt}
    class="prod-image"
    data-product-gallery-image
  />

  {hasMultipleImages && (
    <div class="product-gallery-thumbnails" role="group" aria-label={text.gallery}>
      {imageDetails.map((image, index) => (
        <button
          type="button"
          class="product-gallery-thumbnail"
          aria-label={text.select(index)}
          aria-controls={`${id}-image`}
          aria-pressed={index === 0 ? 'true' : 'false'}
          data-gallery-src={image.path}
          data-gallery-srcset={`${image.path} 500w, ${image.path} ${imageWidth}w`}
          data-gallery-alt={image.alt}
        >
          <img
            src={image.path}
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
            width="96"
            height="96"
          />
        </button>
      ))}
    </div>
  )}
</div>

{hasMultipleImages && (
  <script>
    document.querySelectorAll<HTMLElement>('[data-product-gallery]').forEach((gallery) => {
      const mainImage = gallery.querySelector<HTMLImageElement>('[data-product-gallery-image]');
      const thumbnails = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-src]'));

      if (!mainImage) return;

      thumbnails.forEach((thumbnail) => {
        thumbnail.addEventListener('click', () => {
          const src = thumbnail.dataset.gallerySrc;
          const srcset = thumbnail.dataset.gallerySrcset;

          if (!src || !srcset) return;

          mainImage.src = src;
          mainImage.srcset = srcset;
          mainImage.alt = thumbnail.dataset.galleryAlt ?? '';

          thumbnails.forEach((candidate) => {
            candidate.setAttribute('aria-pressed', String(candidate === thumbnail));
          });
        });
      });
    });
  </script>
)}

<style>
  .product-gallery {
    width: var(--size-full-width);
    min-width: 0;
  }

  .product-gallery-thumbnails {
    width: var(--size-full-width);
    margin-top: var(--space-3);
    padding-bottom: var(--space-1);
    gap: var(--space-3);
    display: flex;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
  }

  .product-gallery-thumbnail {
    box-sizing: border-box;
    width: var(--tap-target-min-size);
    height: var(--tap-target-min-size);
    min-width: var(--tap-target-min-size);
    padding: var(--space-1);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    cursor: pointer;
  }

  .product-gallery-thumbnail[aria-pressed="true"] {
    border-color: var(--color-link);
    /* box-shadow: inset 0 0 0 0.5px var(--color-brand-hover); */
  }

  .product-gallery-thumbnail:hover {
    border-color: var(--color-link);
  }

  .product-gallery-thumbnail img {
    width: var(--size-full-width);
    height: var(--size-full-height);
    object-fit: contain;
  }

  @media (prefers-reduced-motion: no-preference) {
    .product-gallery-thumbnail {
      transition: border-color .2s, box-shadow .2s;
    }
  }
</style>
