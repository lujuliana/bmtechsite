---
import type { Job } from "../data/jobs";

interface Props {
  job: Job;
  revealDelay?: number;
}

const { job, revealDelay = 0 } = Astro.props as Props;
---

<style>
    .job-card-item {
        width: var(--size-full-width);
        list-style: none;
    }
    .job-card {
        padding: var(--space-5) var(--space-4);
        border-bottom: 1px solid var(--color-border);
        overflow: hidden;
    }
    .job-card-link {
        display: block;
        color: inherit;
        text-decoration: none;
    }
    .job-card-content {
        height: 100%;
        min-height: 0;
        flex-direction: column;
        display: flex;
    }
    .job-card-meta,
    .job-card-overview {
        color: var(--color-text-muted);
        margin-bottom: var(--space-3);
    }
    .job-card-action {
        margin-top: auto;
        margin-bottom: 0;
        font-weight: 600;
        color: var(--color-brand);
    }
    .job-card-overview {
        flex: 0 0 auto;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    @media screen and (max-width: 767px) {
        .job-card-overview {
            -webkit-line-clamp: 2;
            line-clamp: 2;
        }
    }
    .job-card-action:hover {
        color: var(--color-link);
    }
    .job-card-link:hover {
        color: var(--color-link-inverse);
    }
    .job-card-title {
        margin-top: 0;
        color: var(--color-brand);
    }
    .job-card:hover {
        background-color: var(--color-surface-muted);
        border-radius: var(--radius-sm);
    }
</style>

<li class="job-card-item" data-scroll-reveal data-scroll-reveal-delay={revealDelay}>
  <article class="job-card">
    <a class="job-card-link" href={`/careers/${job.slug}`}>
        <div class="job-card-content">
            <h3 class="h3 job-card-title">{job.title}</h3>
            <p class="job-card-meta">{job.location} • {job.employmentType}</p>
            <p class="job-card-overview">{job.overview}</p>
            <p class="job-card-action">View more...</p>
        </div>
    </a>
  </article>
</li>
