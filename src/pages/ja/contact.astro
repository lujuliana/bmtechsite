---
import ContactPage from '../../components/ContactPage.astro';
import Layout from '../../layouts/Layout.astro';

const copy = {
  heading: 'お気軽にご相談ください',
  introduction: 'ご質問、製品に関するお問い合わせ、コラボレーションのご相談など、フォームまたはメールよりお気軽にご連絡ください。担当者より折り返しご連絡いたします。',
  officeLabel: '本社',
  officeAddress: ['Suite 325, 1255 W 15th St', 'Plano, TX 75075, USA'],
  factoryLabel: '工場',
  factoryAddress: ['Suite 103, 789 N Grove Rd', 'Richardson, TX 75081, USA'],
  emailLabel: 'メールアドレス',
  socialLabel: 'SNS',
} as const;
---

<Layout
  locale="ja"
  title="お問い合わせ | Contact"
  currentPath="/ja/contact"
  description="BMTechの製品で構築をはじめませんか？製品に関するお問い合わせ、技術サポートなどは、こちらから直接チームへご連絡ください。"
  ogTitle="お問い合わせ | Contact"
  ogDescription="BMTechの製品で構築をはじめませんか？製品に関するお問い合わせ、技術サポートなどは、こちらから直接チームへご連絡ください。"
  ogImage="/images/metal-sign.png"
  webflowPageId="6a1f15d68331060a67be7820"
>
  <Fragment slot="head">
    <style>html.w-mod-js:not(.w-mod-ix3) :is(.linked-nav-logo) {visibility: hidden !important;}</style>
  </Fragment>

  <Fragment slot="scripts">
    <script src="/js/contact-form.js" type="text/javascript"></script>
  </Fragment>

  <ContactPage locale="ja" bannerTitle="お問い合わせ" bannerImageAlt="Solar panels in a field" {copy} />
</Layout>
