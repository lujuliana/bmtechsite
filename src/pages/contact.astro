---
import ContactPage from '../components/ContactPage.astro';
import Layout from '../layouts/Layout.astro';

const copy = {
  heading: 'Get in touch',
  introduction: 'Have a question, interested in our products, or looking to collaborate? Fill out the form or send an email, and our team will follow up with you shortly.',
  officeLabel: 'Office',
  officeAddress: ['1255 W 15th St, Ste 325', 'Plano, TX 75075'],
  factoryLabel: 'Factory',
  factoryAddress: ['789 N Grove Rd, Ste 103', 'Richardson, TX 75081'],
  emailLabel: 'Email',
  socialLabel: 'LinkedIn',
} as const;

---

<Layout
  locale="en"
  title="Contact Us | BMTech"
  currentPath="/contact"
  description="Ready to build with BMTech? Contact our team directly for product inquiries, technical support, and more."
  ogTitle="Contact Us | BMTech"
  ogDescription="Ready to build with BMTech? Contact our team directly for product inquiries, technical support, and more."
  ogImage="/images/metal-sign.png"
  webflowPageId="6a1f15d68331060a67be7820"
>
  <Fragment slot="head">
    <style>html.w-mod-js:not(.w-mod-ix3) :is(.linked-nav-logo) {visibility: hidden !important;}</style>
  </Fragment>

  <Fragment slot="scripts">
    <script src="/js/contact-form.js" type="text/javascript"></script>
  </Fragment>

  <ContactPage locale="en" bannerTitle="Contact Us" bannerImageAlt="A field of solar panels" {copy} />
</Layout>
