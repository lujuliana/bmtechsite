---
import Layout from "../layouts/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
---

<Layout
  locale="en"
  title="About | BMTech"
  currentPath="/about"
  description="Learn about BMTech and our expertise in battery management, energy management, and advanced energy storage technologies."
  ogTitle="About | BMTech"
  ogDescription="Learn about BMTech and our expertise in battery management, energy management, and advanced energy storage technologies."
  ogImage="/images/metal-sign.png"
  webflowPageId="6a26e1187bec4a9fc6e82c52"
>
  <Fragment slot="head">
    <style>
      html.w-mod-js:not(.w-mod-ix3) :is(.linked-nav-logo) {
        visibility: hidden !important;
      }
    </style>
  </Fragment>

  <div class="w-layout-vflex main-wrapper">
    <PageBanner
      title="About"
      webflowVariant="overlay-dark"
      imageSrc="/images/power-network.jpg"
      imageAlt=""
      imageWidth={4000}
      imageHeight={3000}
    />
    <div class="section about-section">
      <section
        class="section-container about-intro-section"
        data-scroll-reveal
      >
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ec"
          class="section-col-aside"
        >
          <h2 class="h2">Engineering Smarter Energy Solutions.</h2>
        </div>
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ee"
          class="section-col-content"
        >
          <p class="sm-txt gray">
            BMTech is a Dallas-based clean technology company specializing in
            Battery Management Systems (BMS), Energy Management Systems (EMS),
            and integrated technologies for modern energy storage applications.
          </p>
          <p class="sm-txt gray">
            Since our founding, we have focused on developing the technology
            needed to manage increasingly sophisticated battery and energy
            systems. Our engineering combines intelligent system control with
            purpose-built hardware to support dependable operation across a wide
            range of energy storage applications.
          </p>
        </div>
      </section>

      <!-- Our Vision -->
      <section
        class="section-container"
        data-scroll-reveal
      >
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ec"
          class="section-col-aside"
        >
          <img
            class="section-col-img"
            src="/images/power-network.jpg"
            alt=""
            loading="lazy"
          />
        </div>
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ef"
          class="section-col-content"
        >
          <h2 class="h2">Our Vision</h2>
          <p class="sm-txt gray">
            We believe the continued growth of energy storage will depend on
            more capable technologies for managing increasingly sophisticated
            battery systems. As these systems become larger and more deeply
            integrated into modern energy infrastructure, effective management
            is essential to maintaining dependable operation. BMTech is focused
            on advancing the technologies that provide greater visibility into
            system performance and more precise control over how energy is
            stored and managed.
          </p>
          <p class="sm-txt gray">
            Our approach is grounded in the practical demands of real-world
            energy systems, from individual battery packs to large-scale
            installations. We continue to develop our capabilities as the
            industry evolves, with the goal of supporting safer and more
            efficient energy storage while helping customers meet changing
            technical requirements.
          </p>
        </div>
      </section>

      <!-- Our Expertise -->
      <section
        class="section-container feature-section"
        data-scroll-reveal
      >
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ec"
          class="section-col-aside"
        >
          <h2 class="h2">Our Expertise</h2>
          <p class="sm-txt gray">
            BMTech develops battery and energy management technologies for a
            broad range of system architectures and operating requirements, from
            battery-level monitoring and control to system-level energy
            management.
          </p>
          <p class="sm-txt gray">
            Our portfolio includes more than 20 products across BMS, EMS,
            battery pack technologies, and microgrid power management,
            reflecting our experience across multiple levels of modern energy
            storage systems.
          </p>
        </div>
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ed"
          class="section-col-content"
        >
          <div class="feature-grid">
            <div
              class="feature-card"
              tabindex="0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-cpu-icon lucide-cpu feature-card-icon"
                ><path d="M12 20v2"></path><path d="M12 2v2"></path><path
                  d="M17 20v2"></path><path d="M17 2v2"></path><path d="M2 12h2"
                ></path><path d="M2 17h2"></path><path d="M2 7h2"></path><path
                  d="M20 12h2"></path><path d="M20 17h2"></path><path
                  d="M20 7h2"></path><path d="M7 20v2"></path><path d="M7 2v2"
                ></path><rect
                  x="4"
                  y="4"
                  width="16"
                  height="16"
                  rx="2"
                ></rect><rect
                  x="8"
                  y="8"
                  width="8"
                  height="8"
                  rx="1"
                ></rect></svg
              >
              <div>Battery Management Systems (BMS)</div>
              <p class="feature-description">
                Battery monitoring and control for safe, reliable operation.
              </p>
            </div>
            <div
              class="feature-card"
              tabindex="0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-chart-no-axes-combined-icon lucide-chart-no-axes-combined feature-card-icon"
                ><path d="M12 16v5"></path><path d="M16 14.639V21"></path><path
                  d="M20 10.656V21"></path><path
                  d="m22 3-8.646 8.646a.5.5 0 0 1-.708 0L9.354 8.354a.5.5 0 0 0-.707 0L2 15"
                ></path><path d="M4 18.463V21"></path><path d="M8 14.656V21"
                ></path></svg
              >
              <div>Energy Management Systems (EMS)</div>
              <p class="feature-description">
                System-level management of energy storage and power resources.
              </p>
            </div>
            <div
              class="feature-card"
              tabindex="0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-battery-medium-icon lucide-battery-medium feature-card-icon"
                ><path d="M10 14v-4"></path><path d="M22 14v-4"></path><path
                  d="M6 14v-4"></path><rect
                  x="2"
                  y="6"
                  width="16"
                  height="12"
                  rx="2"
                ></rect></svg
              >
              <div>Battery Pack Technologies</div>
              <p class="feature-description">
                Integrated technologies for battery pack management and
                operation.
              </p>
            </div>
            <div
              class="feature-card"
              tabindex="0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-network-icon lucide-network feature-card-icon"
                ><rect
                  x="16"
                  y="16"
                  width="6"
                  height="6"
                  rx="1"
                ></rect><rect
                  x="2"
                  y="16"
                  width="6"
                  height="6"
                  rx="1"
                ></rect><rect
                  x="9"
                  y="2"
                  width="6"
                  height="6"
                  rx="1"
                ></rect><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"
                ></path><path d="M12 12V8"></path></svg
              >
              <div>Microgrid Power Management Solutions</div>
              <p class="feature-description">
                Intelligent control for distributed energy and microgrid
                systems.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Partnerships -->
      <section
        class="section-container"
        data-scroll-reveal
      >
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ec"
          class="section-col-aside"
        >
          <img
            src="/images/stacked-thing.jpg"
            loading="lazy"
            sizes="(max-width: 960px) 100vw, 960px"
            srcset="/images/stacked-thing-p-500.jpg 500w, /images/stacked-thing-p-800.jpg 800w, /images/stacked-thing.jpg 960w"
            alt="green energy factory"
            class="section-col-img"
          />
        </div>
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ee"
          class="section-col-content"
        >
          <h2 class="h2">Built on Strong Partnerships</h2>
          <p class="sm-txt gray">
            BMTech has developed an extensive network of suppliers and
            manufacturing partners across the battery and energy storage
            industry. These relationships are an important part of our
            development and production process, connecting our engineering team
            with proven components and specialized manufacturing capabilities.
            Close coordination throughout development keeps production
            considerations integrated into the engineering process as designs
            progress toward manufacturing.
          </p>
          <p class="sm-txt gray">
            Our partnerships have grown alongside BMTech’s product portfolio and
            support projects with a range of technical and production
            requirements. Strong supplier and manufacturing relationships remain
            central to our commitment to consistent product quality and
            dependable production.
          </p>
        </div>
      </section>

      <!-- Applications -->
      <section
        class="section-container feature-section"
        data-scroll-reveal
      >
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ef"
          class="section-col-aside"
        >
          <h2 class="h2">Applications</h2>
          <p class="sm-txt gray">
            BMTech technologies support energy storage systems across a wide
            range of applications, including grid energy storage, renewable
            energy systems, residential installations, and uninterruptible power
            supplies.
          </p>
          <p class="sm-txt gray">
            We work closely with customers to address the requirements of each
            application, providing battery and energy management technologies
            designed for reliable operation across different system
            environments.
          </p>
        </div>
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6f0"
          class="section-col-content"
        >
          <div class="feature-grid">
            <div
              class="feature-card"
              tabindex="0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-utility-pole-icon lucide-utility-pole feature-card-icon"
                ><path d="M12 2v20"></path><path d="M2 5h20"></path><path
                  d="M3 3v2"></path><path d="M7 3v2"></path><path d="M17 3v2"
                ></path><path d="M21 3v2"></path><path d="m19 5-7 7-7-7"
                ></path></svg
              >
              <div>Grid Energy Storage</div>
              <p class="feature-description">
                Reliable monitoring and control for large-scale energy storage
                systems.
              </p>
            </div>
            <div
              class="feature-card"
              tabindex="0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-solar-panel-icon lucide-solar-panel feature-card-icon"
                ><path d="M11 2h2"></path><path d="m14.28 14-4.56 8"
                ></path><path d="m21 22-1.558-4H4.558"></path><path d="M3 10v2"
                ></path><path
                  d="M6.245 15.04A2 2 0 0 1 8 14h12a1 1 0 0 1 .864 1.505l-3.11 5.457A2 2 0 0 1 16 22H4a1 1 0 0 1-.863-1.506z"
                ></path><path d="M7 2a4 4 0 0 1-4 4"></path><path
                  d="m8.66 7.66 1.41 1.41"></path></svg
              >
              <div>Renewable Energy Systems</div>
              <p class="feature-description">
                Coordinated management for renewable energy assets and power
                resources.
              </p>
            </div>
            <div
              class="feature-card"
              tabindex="0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-house-plug-icon lucide-house-plug feature-card-icon"
                ><path d="M10 12V8.964"></path><path d="M14 12V8.964"
                ></path><path
                  d="M15 12a1 1 0 0 1 1 1v2a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2v-2a1 1 0 0 1 1-1z"
                ></path><path
                  d="M8.5 21H5a2 2 0 0 1-2-2v-9a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2h-5a2 2 0 0 1-2-2v-2"
                ></path></svg
              >
              <div>Residential Energy Storage</div>
              <p class="feature-description">
                Smart energy control for dependable home storage systems.
              </p>
            </div>
            <div
              class="feature-card"
              tabindex="0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-plug-zap-icon lucide-plug-zap feature-card-icon"
                ><path
                  d="M6.3 20.3a2.4 2.4 0 0 0 3.4 0L12 18l-6-6-2.3 2.3a2.4 2.4 0 0 0 0 3.4Z"
                ></path><path d="m2 22 3-3"></path><path d="M7.5 13.5 10 11"
                ></path><path d="M10.5 16.5 13 14"></path><path
                  d="m18 3-4 4h6l-4 4"></path></svg
              >
              <div>Uninterruptible Power Supplies (UPS)</div>
              <p class="feature-description">
                Backup power management for critical systems and operations.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- end -->
    </div>
  </div>
</Layout>

<style>
  .section-container {
    margin-inline: auto;
  }

  .feature-section .section-col-content {
    width: 55%;
    flex: 0 1 55%;
  }

  .feature-card {
    position: relative;
    min-height: 14rem;
    padding: var(--space-6);
    background: transparent;
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    text-align: left;
    gap: var(--space-3);
    font-weight: var(--font-weight-semibold);
    overflow: hidden;
    transition: background-color 180ms ease;
  }

  .feature-card:nth-child(odd) {
    border-right: 1px solid var(--color-border-subtle);
  }

  .feature-card:nth-child(-n + 2) {
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .feature-card-icon {
    width: 26px;
    height: 26px;
    color: inherit;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
  }

  .feature-card::after {
    position: absolute;
    right: var(--space-6);
    bottom: 0;
    left: var(--space-6);
    height: 1px;
    background-color: var(--color-brand);
    content: "";
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition:
      opacity 180ms ease,
      transform 220ms ease;
  }

  .feature-card .feature-card-icon {
    transition: transform 180ms ease;
  }

  .feature-description {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-xs);
    opacity: 0;
    transform: translateY(calc(-1 * var(--space-2)));
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .feature-card:hover,
  .feature-card:focus-visible {
    background-color: color-mix(in srgb, var(--color-brand) 5%, transparent);
    color: var(--color-brand);
    outline: none;
  }

  .feature-card:hover .feature-card-icon,
  .feature-card:focus-visible .feature-card-icon {
    transform: translateY(calc(-1 * var(--space-1)));
    color: var(--color-brand);
  }

  .feature-card:hover .feature-description,
  .feature-card:focus-visible .feature-description {
    opacity: 1;
    transform: translateY(0);
  }

  .feature-card:hover::after,
  .feature-card:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }

  @media screen and (min-width: 992px) {
    .feature-section {
      margin-top: calc(-1 * var(--space-7));
      margin-bottom: calc(-1 * var(--space-8));
    }
  }

  @media screen and (max-width: 991px) {
    .about-intro-section {
      row-gap: 8px;
    }

    .about-intro-section h2 {
      font-size: var(--font-size-heading-1);
    }

    .feature-section {
      row-gap: var(--space-4);
    }

    .feature-card {
      color: var(--color-brand);
    }

    .feature-section .section-col-aside,
    .feature-section .section-col-content {
      width: 100%;
      max-width: 100%;
      flex: 0 1 100%;
    }

    .feature-section .section-col-content {
      flex-basis: 100%;
      align-items: center;
    }

    .feature-description {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media screen and (max-width: 767px) {
    .about-section {
      padding-top: 44px;
    }

    .feature-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-rows: auto;
      gap: 0;
      align-content: start;
      width: 75%;
    }

    .feature-card {
      min-height: auto;
      padding: var(--space-4) 0;
      gap: var(--space-2);
      background-color: transparent;
      transition: none;
    }

    .feature-card:nth-child(odd) {
      border-right: 0;
    }

    .feature-card:not(:last-child) {
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .feature-card:last-child {
      border-bottom: 0;
    }

    .feature-card::after {
      display: none;
    }

    .feature-card .feature-card-icon,
    .feature-description {
      transform: none;
      transition: none;
    }

    .feature-description {
      opacity: 1;
    }

    .feature-card:hover,
    .feature-card:focus-visible {
      background-color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card,
    .feature-card::after,
    .feature-card .feature-card-icon,
    .feature-description {
      transition: none;
    }

    .feature-card:hover .feature-card-icon,
    .feature-card:focus-visible .feature-card-icon,
    .feature-card:hover .feature-description,
    .feature-card:focus-visible .feature-description {
      transform: none;
    }
  }
</style>
