---
import Layout from "../layouts/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
---

<Layout
  locale="en"
  title="About"
  currentPath="/about"
  description="About"
  ogTitle="About"
  ogDescription="About"
  webflowPageId="6a26e1187bec4a9fc6e82c52"
>
  <Fragment slot="head">
    <style>
      html.w-mod-js:not(.w-mod-ix3) :is(.linked-nav-logo) {
        visibility: hidden !important;
      }
    </style>
  </Fragment>

  <div class="w-layout-vflex main-wrapper">
    <PageBanner
      title="About"
      webflowVariant="overlay-dark"
      imageSrc="/images/power-network.jpg"
      imageAlt=""
      imageWidth={4000}
      imageHeight={3000}
    />
    <div class="section">
      <section class="section-container">
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ec"
          class="section-col-aside"
        >
          <h2 class="h2">Engineering Smarter Energy Solutions.</h2>
        </div>
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ee"
          class="section-col-content"
        >
          <p class="sm-txt gray">
            BMTech is a Dallas-based clean technology company specializing in
            Battery Management Systems (BMS), Energy Management Systems (EMS),
            and integrated technologies for modern energy storage applications.
          </p>
          <p class="sm-txt gray">
            Since our founding, we have focused on developing the technology
            needed to manage increasingly sophisticated battery and energy
            systems. Our engineering combines intelligent system control with
            purpose-built hardware to support dependable operation across a wide
            range of energy storage applications.
          </p>
        </div>
      </section>

      <!-- Our Vision -->
      <section class="section-container">
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ec"
          class="section-col-aside"
        >
          <img
            class="section-col-img"
            src="/images/power-network.jpg"
            alt=""
            loading="lazy"
          />
        </div>
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ef"
          class="section-col-content"
        >
          <h2 class="h2">Our Vision</h2>
          <p class="sm-txt gray">
            We believe the continued advancement of energy storage depends on
            effective system management and a clear understanding of operating
            conditions. As battery systems increase in scale and technical
            complexity, the technologies responsible for managing them play an
            increasingly important role in maintaining safe and reliable
            operation.
          </p>
          <p class="sm-txt gray">
            BMTech develops battery and energy management technologies for
            systems ranging from individual battery packs to large-scale energy
            storage installations. Our objective is to provide customers with
            the control and system information needed to manage their energy
            assets effectively while supporting dependable performance
            throughout the life of the system.
          </p>
        </div>
      </section>

      <!-- Our Expertise -->
      <section class="section-container">
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ec"
          class="section-col-aside"
        >
          <h2 class="h2">Our Expertise</h2>
          <p class="sm-txt gray">
            BMTech builds battery and energy management solutions for a broad
            range of system configurations and technical requirements. Our
            portfolio includes more than 20 products spanning BMS, EMS, battery
            pack technologies, and microgrid power management.
          </p>
        </div>
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ed"
          class="section-col-content"
        >
          <div class="w-layout-grid grid">
            <div class="about-card">
              <svg
                class="about-card-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><rect
                  width="16"
                  height="16"
                  x="4"
                  y="4"
                  rx="2"
                ></rect><path
                  d="M9 9h6v6H9zM9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"
                ></path></svg
              >
              <div>Battery Management Systems (BMS)</div>
            </div>
            <div class="about-card">
              <svg
                class="about-card-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path d="M13 2 3 14h7l-1 8 10-12h-7z"></path></svg
              >
              <div>Energy Management Systems (EMS)</div>
            </div>
            <div class="about-card">
              <svg
                class="about-card-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><rect
                  width="16"
                  height="20"
                  x="4"
                  y="2"
                  rx="2"
                ></rect><path d="M9 6h6M9 10h6M9 14h2"></path></svg
              >
              <div>Battery Pack Technologies</div>
            </div>
            <div class="about-card">
              <svg
                class="about-card-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path d="M3 3v18h18M7 16v-4M12 16V8M17 16v-7"></path></svg
              >
              <div>Microgrid Power Management Solutions</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Market Leaders -->
      <section class="section-container">
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ec"
          class="section-col-aside"
        >
          <img
            src="/images/stacked-thing.jpg"
            loading="lazy"
            sizes="(max-width: 960px) 100vw, 960px"
            srcset="/images/stacked-thing-p-500.jpg 500w, /images/stacked-thing-p-800.jpg 800w, /images/stacked-thing.jpg 960w"
            alt="green energy factory"
            class="section-col-img"
          />
        </div>
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ee"
          class="section-col-content"
        >
          <h2 class="h2">Built on Strong Partnerships</h2>
          <p class="sm-txt gray">
            The quality of an energy management product depends on both sound
            engineering and dependable manufacturing. BMTech works with an
            established network of component suppliers and manufacturing
            partners to support the development and production of our
            technologies.
          </p>
          <p class="sm-txt gray">
            These relationships enable us to maintain close oversight of
            component selection and production while upholding consistent
            standards for product quality. They also give us the flexibility to
            address the technical and production requirements of individual
            projects.
          </p>
        </div>
      </section>

      <!-- Applications -->
      <section class="section-container">
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6ef"
          class="section-col-aside"
        >
          <h2 class="h2">Applications</h2>
          <p class="sm-txt gray">
            BMTech products support energy storage applications with widely
            varying operating requirements and system architectures. Our
            products are used in grid energy storage, renewable energy systems,
            residential energy storage, and uninterruptible power supply
            applications, with designs that can be integrated into systems
            ranging from distributed installations to large-scale energy
            infrastructure.
          </p>
        </div>
        <div
          data-w-id="1d07c983-3d6a-4d3d-5bc9-d7fbce51e6f0"
          class="section-col-content"
        >
          <div class="w-layout-grid grid">
            <div class="about-card">
              <svg
                class="about-card-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path d="M3 21h18M4 21l8-18 8 18M7.5 13h9M9.5 8h5"></path></svg
              >
              <div>Grid Energy Storage</div>
            </div>
            <div class="about-card">
              <svg
                class="about-card-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  d="M12 22V8M12 8c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6ZM12 13c0-3.5-2.5-6-6-6 0 3.5 2.5 6 6 6Z"
                ></path></svg
              >
              <div>Renewable Energy Systems</div>
            </div>
            <div class="about-card">
              <svg
                class="about-card-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><path
                  d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zM9 21v-6h6v6"
                ></path></svg
              >
              <div>Residential Energy Storage</div>
            </div>
            <div class="about-card">
              <svg
                class="about-card-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
                ><rect
                  width="16"
                  height="16"
                  x="4"
                  y="4"
                  rx="2"
                ></rect><path d="M9 12h6M12 9v6"></path></svg
              >
              <div>Uninterruptible Power Supplies (UPS)</div>
            </div>
          </div>
        </div>
      </section>

      <!-- end -->
    </div>
  </div>
</Layout>

<style>
  .section-container {
    margin-inline: auto;
  }

  .about-card {
    min-height: 11rem;
    padding: var(--space-7);
    border-radius: var(--radius-sm);
    background-color: #ffffffb9;
    color: var(--color-brand);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
    font-weight: var(--font-weight-semibold);
    box-shadow: 0 2px 5px 1px var(--shadow-color-soft);
  }

  .about-card-icon {
    width: 2rem;
    height: 2rem;
    color: var(--color-brand);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
