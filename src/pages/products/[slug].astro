---
import ProductLayout from '../../layouts/ProductLayout.astro';
import { products } from '../../data/products';
import { getProductBySlug, getProductStaticPaths } from '../../lib/product-routes';

export function getStaticPaths() {
  return getProductStaticPaths();
}

const product = getProductBySlug(Astro.params.slug);
---

<ProductLayout product={product} allProducts={products} locale="en" />
