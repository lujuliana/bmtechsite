---
import ProductLayout from '../../layouts/ProductLayout.astro';
import { products } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug } }));
}

const product = products.find((candidate) => candidate.slug === Astro.params.slug);

if (!product) {
  throw new Error(`Product not found for slug: ${Astro.params.slug}`);
}
---

<ProductLayout product={product} allProducts={products} locale="en" />
